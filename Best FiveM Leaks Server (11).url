MySQL.ready.await()

local waitInterval = math.floor(3600000)

while true do
    local deletePostsQuery = "DELETE FROM lbpicchat_posts WHERE opened = 1 AND saved = 0 AND opened_at < DATE_SUB(CURRENT_TIMESTAMP, INTERVAL 1 DAY)"
    local deletedPostsCount = MySQL.update.await(deletePostsQuery)

    local deleteStoriesQuery = "DELETE FROM lbpicchat_stories WHERE posted_at < DATE_SUB(CURRENT_TIMESTAMP, INTERVAL 1 DAY)"
    local deletedStoriesCount = MySQL.update.await(deleteStoriesQuery)

    local resetLocationsQuery = "UPDATE lbpicchat_accounts SET location_x = NULL, location_y = NULL WHERE location_x IS NOT NULL AND last_seen < DATE_SUB(CURRENT_TIMESTAMP, INTERVAL 1 DAY)"
    local resetLocationsCount = MySQL.update.await(resetLocationsQuery)

    local resetStreaksQuery = "UPDATE lbpicchat_friends SET interaction_streak = 0 WHERE interaction_streak != 0 AND last_streak_time IS NOT NULL AND last_streak_time < DATE_SUB(CURRENT_TIMESTAMP, INTERVAL ? HOUR)"
    local resetStreaksParams = {36}
    local resetStreaksCount = MySQL.update.await(resetStreaksQuery, resetStreaksParams)

    debugprint(string.format("Deleted %s old stories", deletedStoriesCount))
    debugprint(string.format("Deleted %s old posts", deletedPostsCount))
    debugprint(string.format("Reset %s streaks", resetStreaksCount))
    debugprint(string.format("Reset %s locations", resetLocationsCount))

    Wait(waitInterval)
end